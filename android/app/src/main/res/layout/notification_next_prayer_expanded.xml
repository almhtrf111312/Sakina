<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="84dp"
    android:orientation="vertical" android:layoutDirection="ltr">
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/prayer_notification_next"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:gravity="center_vertical|start" android:textDirection="rtl"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="16sp" android:maxLines="1" android:includeFontPadding="false"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/prayer_notification_remaining"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:gravity="center" android:textDirection="rtl"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textStyle="bold" android:textSize="26sp" android:maxLines="1"
            android:includeFontPadding="false" android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="26sp"
            android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/prayer_notification_previous"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:gravity="center_vertical|end" android:textDirection="rtl"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="16sp" android:maxLines="1" android:includeFontPadding="false"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <ImageView android:id="@+id/prayer_notification_progress"
        android:layout_width="match_parent" android:layout_height="6dp"
        android:scaleType="fitXY" android:contentDescription="تقدم الوقت حتى الصلاة القادمة" />
    <TextView android:id="@+id/prayer_notification_details"
        android:layout_width="match_parent" android:layout_height="34dp"
        android:gravity="center" android:textDirection="rtl"
        android:textAppearance="@style/TextAppearance.Compat.Notification"
        android:textSize="15sp" android:maxLines="1" android:includeFontPadding="false"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp"
        android:autoSizeMaxTextSize="15sp" android:autoSizeStepGranularity="1sp" />
</LinearLayout>
