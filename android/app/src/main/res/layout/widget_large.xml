<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="16dp">
    <TextView android:id="@+id/w_city" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="المؤذان" android:textColor="#9DB0AA" android:textSize="12sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="الصلاة القادمة" android:textColor="#C9A86A" android:textSize="13sp" android:layout_marginTop="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="افتح المؤذان لتحديث المواقيت" android:textColor="#5FB59B" android:textSize="25sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#E8EFEC" android:textSize="19sp" android:textStyle="bold" />
    </LinearLayout>
    <ProgressBar android:id="@+id/w_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="10dp"
        android:max="100" android:progressDrawable="@drawable/widget_progress" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="8dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="المتبقي للأذان" android:textColor="#9DB0AA" android:textSize="13sp" />
        <Chronometer android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#C9A86A" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp" android:background="#39524A" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/n0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#E8EFEC" android:textSize="16sp" />
        <TextView android:id="@+id/t0" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#E8EFEC" android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/n1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#E8EFEC" android:textSize="16sp" />
        <TextView android:id="@+id/t1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#E8EFEC" android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/n2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#E8EFEC" android:textSize="16sp" />
        <TextView android:id="@+id/t2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#E8EFEC" android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/n3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#E8EFEC" android:textSize="16sp" />
        <TextView android:id="@+id/t3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#E8EFEC" android:textSize="15sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/n4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#E8EFEC" android:textSize="16sp" />
        <TextView android:id="@+id/t4" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#E8EFEC" android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
