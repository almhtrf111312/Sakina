<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_notification_root"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:orientation="vertical" android:layoutDirection="rtl"
    android:paddingStart="8dp" android:paddingEnd="8dp">
    <TextView android:id="@+id/prayer_notification_title"
        android:layout_width="match_parent" android:layout_height="21dp"
        android:gravity="center_vertical|start" android:textStyle="bold"
        android:textSize="14sp" android:maxLines="1"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
    <TextView android:id="@+id/prayer_notification_details"
        android:layout_width="match_parent" android:layout_height="21dp"
        android:gravity="center_vertical|start" android:textSize="12sp"
        android:maxLines="1" android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="12sp"
        android:autoSizeStepGranularity="1sp" />
    <ImageView android:id="@+id/prayer_notification_progress"
        android:layout_width="match_parent" android:layout_height="6dp"
        android:scaleType="fitXY" android:contentDescription="تقدم الوقت حتى الصلاة القادمة" />
</LinearLayout>
