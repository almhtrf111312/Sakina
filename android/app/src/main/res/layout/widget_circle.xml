<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_ring" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_gravity="center" android:scaleType="fitCenter" android:contentDescription="تقدم الصلاة القادمة"
        android:background="@drawable/widget_circle_preview" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="26dp">
        <TextView android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="الأحد 15 نوفمبر" android:textColor="#B0C3BD" android:textSize="11sp" android:maxLines="1" />
        <TextView android:id="@+id/w_clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="01:42 م" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/w_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="العصر" android:textColor="#5FB59B" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="03:06 م" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="1" />
        <Chronometer android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="01:24" android:textColor="#B0C3BD" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
